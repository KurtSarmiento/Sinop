@model PagedResult<BookCopyResponse>

@{
    ViewData["Title"] = "Inventory";
}

<h2>Physical Inventory</h2>

<div class="card">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr>
                <th style="text-align:left;">Accession Number</th>
                <th style="text-align:left;">Book</th>
                <th style="text-align:center;">Status</th>
                <th style="text-align:center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var copy in Model.Items)
            {
                <tr>
                    <td>@copy.AccessionNumber</td>
                    <td>@copy.BookTitle</td>
                    <td style="text-align:center;">@copy.Status</td>
                    <td style="text-align:center;">
                        <a asp-action="Details" asp-route-id="@copy.Id" class="btn btn-outline" style="padding:0.25rem 0.5rem; font-size:0.85rem;">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="muted" style="margin-top:0.5rem;">
    Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)
</div>

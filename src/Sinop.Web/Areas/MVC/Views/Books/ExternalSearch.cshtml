@model PagedResult<OpenLibraryBookPreview>
@using Sinop.Domain.Entities

@{
	ViewData["Title"] = "Search Open Library";
	var categories = ViewData["Categories"] as IEnumerable<Category> ?? Enumerable.Empty<Category>();
}

<div class="section-heading">
	<div>
		<h2>Search Open Library</h2>
		<p>Find titles from the live Open Library catalog, then add them to this library.</p>
	</div>
</div>

<div class="card">
	<form asp-action="ExternalSearch" method="get">
		<div class="catalog-filter-grid">
			<div class="field">
				<label for="external-search">Title</label>
				<input id="external-search" type="text" name="search" value="@ViewData["Search"]" placeholder="Search by title" />
			</div>
			<div class="field">
				<label for="external-author">Author</label>
				<input id="external-author" type="text" name="author" value="@ViewData["Author"]" placeholder="Author name" />
			</div>
			<div class="field">
				<label for="external-year">Published year</label>
				<input id="external-year" type="number" name="publicationYear" min="1000" max="2100" value="@ViewData["PublicationYear"]" placeholder="e.g. 1987" />
			</div>
		</div>
		<div class="catalog-filter-actions">
			<span></span>
			<div class="button-row">
				<button type="submit" class="btn">Search</button>
				<a asp-action="ExternalSearch" class="btn btn-outline">Clear</a>
				<a asp-action="Index" class="btn btn-outline">Back to catalog</a>
			</div>
		</div>
	</form>
</div>

@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
	<div class="error">@TempData["Error"]</div>
}

<section class="external-grid">
	@foreach (var book in Model.Items)
	{
		var isbn = book.ISBNs.FirstOrDefault();
		<article class="quick-card external-book-card">
			@if (!string.IsNullOrWhiteSpace(book.CoverUrl))
			{
				<div class="external-cover-wrap">
					<div class="book-cover-placeholder external-cover-placeholder"><span>Sinop</span></div>
					<img class="external-cover" src="@book.CoverUrl" alt="Cover of @book.Title" loading="lazy" onerror="this.style.display='none'" />
				</div>
			}
			else
			{
				<div class="book-cover-placeholder external-cover-placeholder"><span>Sinop</span></div>
			}
			<span>Open Library</span>
			<strong>@book.Title</strong>
			<small>@string.Join(", ", book.Authors)</small>
			@if (book.FirstPublishYear.HasValue)
			{
				<small style="display:block; margin-top:0.35rem;">Published @book.FirstPublishYear</small>
			}
			@if (!string.IsNullOrWhiteSpace(isbn))
			{
				<small style="display:block; margin-top:0.35rem;">ISBN @isbn</small>
			}
			@if (book.IsDuplicate)
			{
				<small style="display:block; margin-top:0.75rem; color:#9a3027;">Already in catalog</small>
			}
			else if (!string.IsNullOrWhiteSpace(isbn))
			{
				<form asp-action="ImportExternal" method="post" style="margin-top:0.75rem;">
					@Html.AntiForgeryToken()
					<input type="hidden" name="title" value="@book.Title" />
					<input type="hidden" name="isbn" value="@isbn" />
					<input type="hidden" name="authors" value="@string.Join('|', book.Authors)" />
					<label class="import-field">Category
						<select name="categoryId">
							<option value="">Select a category</option>
							@foreach (var category in categories)
							{
								<option value="@category.Id">@category.Name</option>
							}
						</select>
					</label>
					<label class="import-field">Summary
						<textarea name="summary" rows="3" placeholder="Add a summary"></textarea>
					</label>
					<label class="import-field">Available copies
						<input type="number" name="copyCount" value="1" min="0" max="1000" />
					</label>
					<button type="submit" class="btn">Add to catalog</button>
				</form>
			}
		</article>
	}
</section>

@if (Model.TotalPages > 1)
{
	<div class="catalog-pagination">
		<span class="muted">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
		<div class="button-row">
			@if (Model.Page > 1)
			{
				<a asp-action="ExternalSearch" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@ViewData["Search"]" asp-route-author="@ViewData["Author"]" asp-route-publicationYear="@ViewData["PublicationYear"]" class="btn btn-outline">Previous</a>
			}
			@if (Model.Page < Model.TotalPages)
			{
				<a asp-action="ExternalSearch" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@ViewData["Search"]" asp-route-author="@ViewData["Author"]" asp-route-publicationYear="@ViewData["PublicationYear"]" class="btn">Next</a>
			}
		</div>
	</div>
}

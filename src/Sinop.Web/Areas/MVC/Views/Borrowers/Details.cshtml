@model BorrowerResponse

@{
    ViewData["Title"] = "Borrower Details";
}

<h2>Borrower Details</h2>

<div class="card">
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Role:</strong> @Model.Role</p>
    <p><strong>Full Name:</strong> @Model.FullName</p>
    <p><strong>Active Loans:</strong> @Model.ActiveLoans</p>
    <p><strong>Active Reservations:</strong> @Model.ActiveReservations</p>
</div>

<a asp-action="Index" class="btn btn-outline">Back to Borrowers</a>
